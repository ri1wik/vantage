# Vantage configuration. Copy to .env and fill in only what you need.
# With no keys set, Vantage runs the deterministic `mock` baseline end to end.

VANTAGE_MODEL=mock              # mock | gemini | openai | groq | ollama
VANTAGE_DB=data/warehouse.db
VANTAGE_MAX_ATTEMPTS=3          # bounded self-correction budget
VANTAGE_ROW_LIMIT=500           # hard LIMIT injected into every query
VANTAGE_QUERY_TIMEOUT_S=10
VANTAGE_LOG_DIR=logs

# GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# VANTAGE_MODEL_NAME=            # override the per-provider default model id
